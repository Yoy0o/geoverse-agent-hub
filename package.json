{
  "name": "agent-hub",
  "version": "0.1.0",
  "description": "自托管 Agent 工作台：任务、评审、规则 + 多 coding agent 接入（MCP / 钩子 / OTel）",
  "main": "src/server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "cli": "node --disable-warning=ExperimentalWarning src/cli.js",
    "test": "bash test/e2e.sh",
    "dev:cloudflare": "wrangler dev",
    "build:cloudflare": "wrangler deploy --dry-run --outdir .cloudflare/dist",
    "preflight:cloudflare": "node scripts/cloudflare-preflight.mjs",
    "secret:cloudflare": "node scripts/cloudflare-secret.mjs",
    "bootstrap:cloudflare": "node scripts/cloudflare-preflight.mjs --bootstrap && wrangler deploy",
    "deploy:cloudflare": "node scripts/cloudflare-preflight.mjs && wrangler deploy",
    "test:preflight": "node --test test/cloudflare-preflight.test.mjs",
    "types:cloudflare": "wrangler types .cloudflare/worker-configuration.d.ts",
    "test:security": "node --test test/security.test.mjs",
    "test:cloudflare": "node test/cloudflare.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "jszip": "^3.10.2",
    "zod": "^4.6.5"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.1",
    "@types/node": "^22.20.4",
    "wrangler": "^4.144.0"
  },
  "imports": {
    "#hub/config": {
      "workerd": "./src/cloudflare/config.js",
      "default": "./src/config.js"
    },
    "#hub/db": {
      "workerd": "./src/cloudflare/db.js",
      "default": "./src/db.js"
    },
    "#hub/templates": {
      "workerd": "./src/cloudflare/templates.js",
      "default": "./src/templates.js"
    }
  }
}
