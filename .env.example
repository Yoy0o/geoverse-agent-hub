# ---- 基本 ----
# 访问令牌（Agent、脚本、网页登录都用它）。留空则首次启动自动生成，保存在数据卷的 hub-token 文件里
HUB_TOKEN=
# 端口映射：默认只监听本机 127.0.0.1:8787；服务器 / 局域网部署改成 0.0.0.0（务必配合防火墙或 Tailscale）
HUB_BIND=127.0.0.1
HUB_PORT=8787
# 网页会话有效期（秒），服务端强制检查；默认 7 天，最长 30 天
SESSION_TTL_SECONDS=604800

# ---- 公网访问（可选）----
# hub 的对外 HTTPS 地址，例如 https://hub.example.com。设置后接入命令、OAuth 都用它
PUBLIC_URL=
# 1 = 开启 OAuth，claude.ai / Cowork / Claude 手机端可以把 hub 加为自定义连接器（需要 PUBLIC_URL 是 HTTPS）
OAUTH_ENABLED=0
# Cloudflare Tunnel 令牌（docker compose --profile tunnel up -d 时使用）
CLOUDFLARE_TUNNEL_TOKEN=

# ---- 成本 ----
# OTel 上报的是美元，界面换算成人民币
USD_CNY=7.2
# 只上报 token 的 Agent（如 Codex）按此价格估算成本：美元 / 百万 token，例如
# PRICE_TABLE={"gpt-5.5":{"in":1.25,"out":10}}
PRICE_TABLE=

# ---- 数据 ----
# 钩子载荷的存储：summary（默认，只存工具名、文件、命令摘要）/ full（完整载荷，截断到 32KB）/ none
HUB_STORE_PAYLOAD=summary
EVENT_RETENTION_DAYS=90

# ---- 网页里的“让 AI 解析回执 / 提炼规则 / 起草复盘”（可选）----
# anthropic，或 openai（任何 OpenAI 兼容接口：DeepSeek、通义、Kimi、本地 vLLM 等）
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# 兼容接口的地址，例如 https://api.deepseek.com/v1；用 Anthropic 时留空
LLM_BASE_URL=
