# ---- 基本 ----
# 访问令牌（Agent、脚本、网页登录都用它）。留空则首次启动自动生成，保存在数据卷的 hub-token 文件里
HUB_TOKEN=
# 端口映射：默认只监听本机 127.0.0.1:8787；服务器 / 局域网部署改成 0.0.0.0（务必配合防火墙或 Tailscale）
HUB_BIND=127.0.0.1
HUB_PORT=8787
# 网页会话有效期（秒），服务端强制检查；默认 7 天，最长 30 天
SESSION_TTL_SECONDS=604800

# ---- 公网访问（可选）----
# hub 的对外 HTTPS 地址，例如 https://hub.example.com。设置后接入命令、OAuth 都用它
PUBLIC_URL=
# 1 = 开启 OAuth，claude.ai / Cowork / Claude 手机端可以把 hub 加为自定义连接器（需要 PUBLIC_URL 是 HTTPS）
OAUTH_ENABLED=0
# Cloudflare Tunnel 令牌（docker compose --profile tunnel up -d 时使用）
CLOUDFLARE_TUNNEL_TOKEN=

# ---- 成本 ----
# OTel 上报的是美元，界面换算成人民币
USD_CNY=7.2
# 只上报 token 的 Agent（如 Codex）按此价格估算成本：美元 / 百万 token，例如
# PRICE_TABLE={"gpt-5.5":{"in":1.25,"out":10}}
PRICE_TABLE=

# ---- Hub 身份与执行管理 ----
# 网页标题栏和同步对端显示的名称；云端部署默认“云端 Hub”
HUB_NAME=本地 Hub
# 执行多久没有心跳算“停滞”（分钟）；执行端多久没有心跳算“离线”（秒）
RUN_STALL_MINUTES=15
RUNNER_OFFLINE_SECONDS=90

# ---- 多端同步（云端唯一：只在迁移时用一次，或把停用的本地 Hub 当只读镜像）----
# 本 Hub 主动与对端 Hub（云端）同步任务、规则、复盘和设置；对端无需配置
# 迁移：备份 → node src/cli.js sync --dry-run 预览 → node src/cli.js retire <云端地址>（自动最后同步并停用本 Hub）
# 只读镜像：停用后改成 HUB_SYNC_MODE=pull、HUB_SYNC_INTERVAL=600
HUB_SYNC_URL=
# 对端 Hub 的令牌（不是本机的 HUB_TOKEN）
HUB_SYNC_TOKEN=
# 对端在 Cloudflare Access 后面时的服务凭证
HUB_SYNC_ACCESS_CLIENT_ID=
HUB_SYNC_ACCESS_CLIENT_SECRET=
# 自动同步间隔（秒），0 = 只手动；both 双向 / pull 只拉取 / push 只推送
HUB_SYNC_INTERVAL=0
HUB_SYNC_MODE=both
# 本 Hub 退役为只读并指向云端（一般用 node src/cli.js retire 设置，不必在这里写）
HUB_RETIRED_TO=

# ---- 数据 ----
# 钩子载荷的存储：summary（默认，只存工具名、文件、命令摘要）/ full（完整载荷，截断到 32KB）/ none
HUB_STORE_PAYLOAD=summary
EVENT_RETENTION_DAYS=90

# ---- 网页里的“让 AI 解析回执 / 提炼规则 / 起草复盘”（可选）----
# anthropic，或 openai（任何 OpenAI 兼容接口：DeepSeek、通义、Kimi、本地 vLLM 等）
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# 兼容接口的地址，例如 https://api.deepseek.com/v1；用 Anthropic 时留空
LLM_BASE_URL=
