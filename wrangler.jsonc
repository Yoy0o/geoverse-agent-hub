{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "geoverse-agent-hub",
  "account_id": "4352e30845d3f1e76df79a75666ba6f8",
  "main": "src/cloudflare/worker.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "secrets": { "required": ["HUB_TOKEN"] },
  "build": { "command": "node scripts/cloudflare-build.mjs" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "AgentHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AgentHub"] }],
  "vars": {
    "HUB_INSTANCE": "personal",
    "ACCESS_ALLOWED_EMAILS": "hio250@163.com",
    "ACCESS_TEAM_DOMAIN": "steep-pond-6404.cloudflareaccess.com",
    "ACCESS_AUD": "a049a951794c5484ed385de14964e4732d6170423f8a2287b1ac64c70705a67e",
    "ACCESS_SERVICE_IDS": "b0adc3f78cd3bc11cdb061576dea8675.access",
    "PUBLIC_URL": "https://geoverse-agent-hub.libra-liuyb.workers.dev",
    "OAUTH_ENABLED": "0",
    "HUB_STORE_PAYLOAD": "summary",
    "EVENT_RETENTION_DAYS": "90",
    "SESSION_TTL_SECONDS": "604800"
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "dev": { "ip": "127.0.0.1", "port": 8788 }
}
